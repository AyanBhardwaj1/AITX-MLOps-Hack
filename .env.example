# Copy to .env.local and fill in what you have. Everything is optional; see DEPLOY.md.
# Never commit real values.

# OpenAI: Copilot, LLM memos, labels for unknown vendors (set a monthly budget first)
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_AGENT=gpt-6.1-sol

# Supabase Postgres: persistent decisions, Inbox and run history
# Connect -> Transaction pooler URI (port 6543) with your database password
DATABASE_URL=
# Project Settings -> Database -> SSL Configuration -> Download certificate (full PEM)
DATABASE_CA_CERT=

# Site-wide password (any username). Required before using a real Rho account.
APP_PASSWORD=

# Rho: the sandbox accepts any non-empty token. Production: https://rhoapi.rho.co/api/v1 + rhobat_ token
RHO_BASE_URL=https://rhoapi-sandbox.rho.co/api/v1
RHO_API_TOKEN=sandbox

# Daily scheduled Autopilot and Monday digest (Vercel Cron). 16+ random characters.
CRON_SECRET=
AUTOPILOT_CRON_MODE=demo

# Monday digest to Slack: an incoming webhook (Slack app → Incoming Webhooks), https://hooks.slack.com/services/...
SLACK_WEBHOOK_URL=

# Jira Cloud: "Approve & file" creates issues
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
