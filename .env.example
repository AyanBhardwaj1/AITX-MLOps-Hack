# Copy to .env.local and fill in. Never commit real values.

# OpenAI: cheap tier for bulk categorization, mid tier for the agents
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_AGENT=gpt-6.1-sol

# Supabase (Project Settings -> API Keys). The secret key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Rho: the sandbox accepts any non-empty token
RHO_BASE_URL=https://rhoapi-sandbox.rho.co/api/v1
RHO_API_TOKEN=sandbox

# Apify (stretch: vendor pricing scrape)
APIFY_TOKEN=
